estoration"}, {"ru": "Эндоскопия позвоночника через разрез до 8 мм, выписка через 1–2 дня", "ko": "8mm 이하 절개 척추내시경, 평균 1~2일 입원", "en": "Spinal endoscopy through an incision of up to 8 mm, discharge in 1–2 days"}], "doctors": [{"name": {"ru": "Сон Джунсоп", "ko": "송준섭", "en": "Song Jun-seop"}, "role": {"ru": "Главный представитель клиники, ортопед", "ko": "대표원장, 정형외과", "en": "Representative director, orthopedic surgeon"}}, {"name": {"ru": "Ким Намин", "ko": "김나민", "en": "Kim Na-min"}, "role": {"ru": "Директор больницы", "ko": "병원장", "en": "Hospital director"}}], "images": [{"src": "https://www.gnjshospital.com/data/editor/2303/thumb-d635397acc348234072bf021d9c7da45_1678237217_1363_1000x.jpg", "caption": {"ru": "Лечение дегенеративного артрита", "ko": "퇴행성 관절염 치료", "en": "Treatment of degenerative arthritis"}}, {"src": "https://www.gnjshospital.com/data/editor/2303/thumb-598ee6773f8b4f2742a466ed5e524e27_1678930095_3442_1200x.jpg", "caption": {"ru": "Регистратура, 1 этаж", "ko": "1층 접수·수납", "en": "Reception, 1st floor"}}, {"src": "https://www.gnjshospital.com/data/editor/2302/thumb-6bd0f52a50de57f49e7ecbde6ce82415_1677490784_6311_1200x.jpg", "caption": {"ru": "Кабинет консультаций", "ko": "2층 상담실", "en": "Consultation room"}}, {"src": "https://www.gnjshospital.com/data/editor/2302/thumb-6bd0f52a50de57f49e7ecbde6ce82415_1677489360_2549_1200x.jpg", "caption": {"ru": "Кабинет МРТ", "ko": "MRI 검사실", "en": "MRI room"}}, {"src": "https://www.gnjshospital.com/data/editor/2303/thumb-d635397acc348234072bf021d9c7da45_1678257075_6161_1200x.jpg", "caption": {"ru": "Операционная", "ko": "중앙수술실 내부", "en": "Operating room"}}, {"src": "https://www.gnjshospital.com/data/editor/2303/thumb-d635397acc348234072bf021d9c7da45_1678257040_9759_1200x.jpg", "caption": {"ru": "Палата пробуждения", "ko": "회복실", "en": "Recovery room"}}, {"src": "https://www.gnjshospital.com/data/editor/2303/thumb-bc810479d022a41ec5f26178c63e0603_1679275609_9847_1200x.jpg", "caption": {"ru": "VIP-палата с полом ондо